<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Visitor Sign-In</title>
    <style>
        /* Force high contrast and visibility */
        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
            -webkit-font-smoothing: antialiased;
        }

        body, html {
            height: 100%;
            width: 100%;
            background-color: #e5e7eb; /* Light grey background */
            font-family: Arial, Helvetica, sans-serif; /* Web-safe font */
        }

        .wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .visitor-card {
            background: #ffffff;
            width: 100%;
            max-width: 500px;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            border: 1px solid #cccccc;
        }

        h1 {
            color: #000000 !important; /* Explicit Black */
            font-size: 28px;
            margin-bottom: 30px;
            text-align: center;
            display: block !important;
        }

        .input-group {
            margin-bottom: 20px;
        }

        label {
            display: block !important;
            color: #000000 !important; /* Explicit Black */
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 8px;
            visibility: visible !important;
        }

        input {
            width: 100%;
            height: 60px;
            padding: 0 15px;
            font-size: 20px;
            border: 2px solid #000000; /* High contrast border */
            border-radius: 8px;
            background-color: #ffffff;
            color: #000000 !important; /* Explicit Black text */
            display: block;
        }

        .submit-btn {
            width: 100%;
            height: 70px;
            background-color: #0052cc !important; /* Solid Blue */
            color: #ffffff !important; /* Explicit White text */
            border: none;
            border-radius: 8px;
            font-size: 22px;
            font-weight: bold;
            margin-top: 10px;
            cursor: pointer;
            display: block !important;
            text-align: center;
        }

